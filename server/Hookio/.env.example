# Copy to server/Hookio/.env.production. Compose injects these into the API container
# (env_file → process environment). The app does not parse this file.
# Local `dotnet run`: set the same names as process environment variables.
# Never commit real values.

PG_CONNECTION_STRING=Host=postgres;Database=hookio;Username=hookio;Password=changeme
REDIS_CONNECTION_STRING=dragonfly:6379
JWT_SECRET=replace-with-256-bit-random-string
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-application-secret
DISCORD_REDIRECT_URI=http://localhost/oauth
HOOKIO_COOKIE_SECURE=false

# Twitch EventSub (HTTPS callback required)
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_EVENTSUB_SECRET=replace-with-10-to-100-char-secret
TWITCH_EVENTSUB_CALLBACK_URL=https://your.public.hostname/api/twitch/eventsub
